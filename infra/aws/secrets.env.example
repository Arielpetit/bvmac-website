# Copy to secrets.env, fill in, then: chmod 600 secrets.env
# secrets.env is git-ignored. Never commit it and never paste it in a chat.
# Plain KEY=VALUE lines. Leave a value empty to skip it.

# --- required ---
BUDGET_EMAIL=

# --- GitHub ---
# Leave GITHUB_TOKEN empty (recommended): the script only creates the apps, and you connect each
# repository yourself in the Amplify console. Fill it only if you want the script to connect GitHub and
# start the first builds too (fine-grained, read-only token, Contents and Webhooks, the two repositories).
GITHUB_TOKEN=
WEB_REPO=https://github.com/skyengpro/bvmac-website
APP_REPO=https://github.com/skyengpro/bvmac-mobile
# One environment per app: the branch each app builds and publishes. The branches must already exist.
WEB_BRANCH=main
APP_BRANCH=master

# --- the site's keys ---
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
GROQ_API_KEY=

# --- optional ---
# Password-protects both apps (private preview). Remove both lines at public launch.
PREVIEW_USERNAME=
PREVIEW_PASSWORD=
# Public addresses. Leave empty to use the free amplifyapp.com addresses first.
SITE_URL=
WEB_DOMAIN=
APP_DOMAIN=
MONTHLY_BUDGET_USD=10
# Use another name for a throwaway test stack (then ./teardown.sh with the same name).
STACK_NAME=bvmac-amplify
