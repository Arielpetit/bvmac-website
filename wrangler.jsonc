{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "bvmac-website",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-10-06",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": { "directory": ".open-next/assets", "binding": "ASSETS" },
  "services": [{ "binding": "WORKER_SELF_REFERENCE", "service": "bvmac-website" }],
  // Public address of this deployment (the DNS record and certificate are created on deploy).
  "routes": [{ "pattern": "bvmac.skyengpro.site", "custom_domain": true }],
  "observability": { "enabled": true }
}
