# Copy to .env.local. The publishable key is safe for the browser; never put a secret/service_role key here.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server only (team management). Never prefix with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=
# Access gate for internal previews (see src/lib/gate.ts). Leave GATE_SECRET empty to switch it off.
GATE_SECRET=
# Testers, comma-separated; create each entry with: node scripts/gate-user.mjs email password
GATE_USERS=
# Shared with the app on a sibling subdomain, e.g. .skyengpro.site
GATE_COOKIE_DOMAIN=
